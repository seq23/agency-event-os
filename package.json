{
  "name": "agency-event-os",
  "version": "0.1.0",
  "private": true,
  "description": "West Peek Live! virtual event production platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run validate:structure && npm run validate:brand && npm run validate:whitelabel-video",
    "structure": "node scripts/validate_structure.js",
    "validate:structure": "node scripts/validate_structure.js",
    "validate:backend-foundation": "npm run test -- --run tests/unit/env.test.ts tests/unit/email.test.ts tests/unit/audit.test.ts",
    "validate:testing-console": "npm run test -- --run tests/unit/testingConsole.test.ts",
    "validate:auth": "npm run test -- --run tests/unit/authSession.test.ts tests/unit/accessResolver.test.ts tests/unit/authActions.test.ts",
    "validate:phase2d2e2f": "npm run test -- --run tests/unit/speakerOps.test.ts tests/unit/sponsorOps.test.ts tests/unit/approvalOps.test.ts tests/unit/eventIntake.test.ts tests/unit/changeControl.test.ts tests/unit/networkingOps.test.ts",
    "validate:persistence": "npm run test -- --run tests/unit/persistenceMapping.test.ts tests/unit/clientEventSchemas.test.ts tests/unit/coreReadModel.test.ts",
    "validate:production-ops-persistence": "npm run test -- --run tests/unit/productionOpsSchemas.test.ts tests/unit/operationalMapping.test.ts tests/unit/productionOpsActions.test.ts",
    "validate:assets": "npm run test -- --run tests/unit/assetRules.test.ts",
    "validate:speaker-sponsor-persistence": "npm run test -- --run tests/unit/speakerSponsorPersistence.test.ts",
    "validate:email-workflows": "npm run test -- --run tests/unit/emailWorkflows.test.ts",
    "validate:production-workflow": "npm run test -- --run tests/unit/productionWorkflowPersistence.test.ts tests/unit/productionWorkflowActions.test.ts",
    "validate:browser-diagnostics": "npm run test -- --run tests/unit/browserDiagnostics.test.ts",
    "validate:video-provider": "npm run test -- --run tests/unit/videoProvider.test.ts",
    "validate:livekit-provider": "npm run test -- --run tests/unit/livekitProvider.test.ts",
    "validate:livekit-room-ui": "npm run test -- --run tests/unit/livekitRoomUi.test.ts",
    "validate:venue-persistence": "npm run test -- --run tests/unit/venuePersistence.test.ts",
    "validate:speed-networking-engine": "npm run test -- --run tests/unit/speedNetworkingEngine.test.ts",
    "validate:reports-exports": "npm run test -- --run tests/unit/reportsExports.test.ts",
    "validate:phase12": "npm run test -- --run tests/unit/preVenueHardening.test.ts",
    "validate:phase13": "npm run test -- --run tests/unit/virtualVenueCompletion.test.ts",
    "validate:phase14": "npm run test -- --run tests/unit/supabaseQueryIntegration.test.ts",
    "validate:phase15": "npm run test -- --run tests/unit/liveProductionOperations.test.ts",
    "validate:phase16": "npm run test -- --run tests/unit/livekitEgress.test.ts",
    "validate:phase17": "npm run test -- --run tests/unit/emailProduction.test.ts",
    "validate:brand": "node scripts/validate_branding.js",
    "validate:whitelabel-video": "node scripts/validate_whitelabel_video.js",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@livekit/components-react": "^2.9.21",
    "@supabase/supabase-js": "2.45.4",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "livekit-client": "^2.19.0",
    "lucide-react": "0.468.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.13.1",
    "@playwright/test": "1.48.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3",
    "vitest": "2.1.3",
    "wrangler": "^4.92.0"
  }
}
