# West Peek Live! environment

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — required for Batch 3A auth/current-user wiring
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Video providers
VIDEO_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=westpeeklive.daily.co
DAILY_FALLBACK_ENABLED=true
AGORA_APP_ID=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Email — deferred
RESEND_API_KEY=

# Payments — deferred
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email sender
EMAIL_FROM="Scooter (CEO of West Peek) <notifications@events.westpeek.live>"

# Auth session cookie
AUTH_SESSION_COOKIE_NAME=agency_event_os_session
# LiveKit primary video provider

EMAIL_REPLY_TO=hello@westpeek.live
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
NEXT_PUBLIC_ENABLE_ZOOM_EMBEDDED_FALLBACK=false
GOOGLE_MEET_MANAGED_FALLBACK_URL=
