# West Peek Live local development example.
# Never commit real secrets. Production secrets live in Cloudflare/GitHub/Supabase settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SESSION_COOKIE_NAME=agency_event_os_session

# V5 access gates. Use strong rotated values in deployed environments.
# Production must set these. Do not use demo values in deployed environments.
CREW_ACCESS_PASSWORD=
V5_ACCESS_COOKIE_SECRET=
V5_CREW_COOKIE_NAME=wpl_crew_access
V5_SPECIAL_GUEST_COOKIE_NAME=wpl_guest_access

# Demo special-guest role codes are local env values only; raw values must not live in repo config/source.
EVENT_DEMO_CLIENT_CODE=
EVENT_DEMO_SPEAKER_CODE=
EVENT_DEMO_SPONSOR_CODE=
EVENT_DEMO_CREW_LITE_CODE=
EVENT_DEMO_VIP_CODE=

# Email / communications.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Video providers.
VIDEO_PROVIDER=mock
# Local/dev only. Production requires a real provider unless this explicit override is set.
ALLOW_MOCK_VIDEO_PROVIDER_IN_PRODUCTION=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=
DAILY_FALLBACK_ENABLED=false
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
NEXT_PUBLIC_ENABLE_ZOOM_EMBEDDED_FALLBACK=false
GOOGLE_MEET_EMERGENCY_URL=

# Publishing / GitHub Actions dispatch.
GITHUB_EVENT_CONFIG_OWNER=
GITHUB_EVENT_CONFIG_REPO=
GITHUB_EVENT_CONFIG_WORKFLOW=publish-event-config.yml
GITHUB_EVENT_CONFIG_TOKEN=
